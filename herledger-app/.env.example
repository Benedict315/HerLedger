# Node environment
NODE_ENV=development
# The canonical URL of the web application
APP_URL=http://localhost:3000
# PostgreSQL connection string
DATABASE_URL=postgresql://herledger:herledger@localhost:5432/herledger_dev
# PostgreSQL shadow database connection string (used for schema diffs in CI)
SHADOW_DATABASE_URL=postgresql://herledger:herledger@localhost:5432/herledger_shadow
# Secret key for auth session encryption
BETTER_AUTH_SECRET=dev-secret-must-be-at-least-32-characters-long
# Stellar network selection
STELLAR_NETWORK=testnet
# Soroban RPC endpoint URL
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# Horizon API endpoint URL
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# Stellar network passphrase
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
# Contract ID for the Business Registry
BUSINESS_REGISTRY_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4
# Contract ID for the Financial Ledger
FINANCIAL_LEDGER_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4
# Contract ID for the Attestation Registry
ATTESTATION_REGISTRY_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4
# Internal URL for the indexer service
INDEXER_API_URL=http://localhost:4000
# Stellar network selection for the browser
NEXT_PUBLIC_STELLAR_NETWORK=testnet
# Soroban RPC endpoint URL for the browser
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# Contract ID for the Business Registry (browser exposed)
NEXT_PUBLIC_BUSINESS_REGISTRY_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4
# Contract ID for the Financial Ledger (browser exposed)
NEXT_PUBLIC_FINANCIAL_LEDGER_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4
# Contract ID for the Attestation Registry (browser exposed)
NEXT_PUBLIC_ATTESTATION_REGISTRY_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4
