{
  "name": "herledger-app",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter web test:e2e",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "env:validate": "pnpm --filter '@herledger/config' exec tsx --conditions react-server src/validate.ts",
    "postinstall": "node scripts/patch-typescript-eslint-ts-peer.mjs",
    "prepare": "cd .. && husky herledger-app/.husky"
  },
  "devDependencies": {
    "@prisma/client": "7.9.1",
    "dotenv": "^17.4.2",
    "eslint": "9.18.0",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "prettier": "3.4.2",
    "prisma": "7.9.1",
    "tsx": "4.19.2",
    "typescript": "7.0.2",
    "typescript-eslint": "8.67.0",
    "typescript-eslint-ts6-compat": "npm:typescript@5.9.3"

  },
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9"
  },
  "dependencies": {
    "@prisma/client": "7.9.1"
  }
}
